# LLM provider: "ollama" (local) or "claude" (Anthropic API — faster, concurrent)
LLM_PROVIDER=ollama

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Anthropic Claude (used when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-haiku-4-5
# Number of concurrent Claude API calls (increase for larger watchlists)
CLAUDE_SCREENER_MAX_WORKERS=5

# News API (https://newsapi.org)
NEWS_API_KEY=your_newsapi_key_here
# Large watchlists: set false to skip NewsAPI and use yfinance only (avoids free-tier rate limits).
USE_NEWS_API=true
# Optional minimum seconds between NewsAPI requests (0 = no delay).
NEWS_API_MIN_INTERVAL_SEC=0

# Alpaca (optional alternative)
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret

# Schwab Trader API (https://developer.schwab.com)
SCHWAB_CLIENT_ID=your_schwab_client_id
SCHWAB_CLIENT_SECRET=your_schwab_client_secret
SCHWAB_REDIRECT_URI=https://127.0.0.1
# Re-auth: python main.py schwab auth  (or python -c "from data.fetchers.schwab_fetcher import SchwabFetcher; SchwabFetcher().authenticate()")

# Schwab feature flags (set USE_SCHWAB=false to revert to yfinance-only mode)
USE_SCHWAB=true
USE_SCHWAB_FOR_ALERTS=true
USE_SCHWAB_FOR_PORTFOLIO=true
SCHWAB_QUOTE_CACHE_SEC=15
SCHWAB_PORTFOLIO_CACHE_SEC=300

# Market data features (require USE_SCHWAB=true)
USE_SCHWAB_MARKET_DATA=true
USE_SCHWAB_FOR_CHARTS=true
USE_SCHWAB_FOR_SCREENING_PRICE=false
USE_SCHWAB_FOR_MOVERS=true
USE_SCHWAB_FOR_OPTIONS=true
USE_SCHWAB_MARKET_HOURS=true
SCHWAB_HISTORY_CACHE_SEC=3600
SCHWAB_MOVERS_CACHE_SEC=300

# Optional Market Data Production–only app (leave blank to reuse trading credentials)
SCHWAB_MARKET_DATA_CLIENT_ID=
SCHWAB_MARKET_DATA_CLIENT_SECRET=
SCHWAB_MARKET_DATA_TOKEN_PATH=./schwab_market_data_token.json

# Notifications (email uses Python stdlib smtplib)
ALERT_EMAIL=your@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# Screening thresholds
MAX_PE_RATIO=25
MIN_PE_RATIO=5
MIN_UPSIDE_PERCENT=15
MAX_DEBT_TO_EQUITY=2.0
MIN_MARKET_CAP=1000000000
SECTORS=Technology,Healthcare,Consumer Discretionary

# Paths
DB_PATH=./storage/stocks.db
TICKER_LIST=./tickers/watchlist.txt

# Yahoo / yfinance (unofficial API — be gentle on large lists)
YFIN_DELAY_SEC=1.25
YFIN_FETCH_WORKERS=1
YFIN_MAX_RETRIES=4
YFIN_BACKOFF_BASE_SEC=2.5
